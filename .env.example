# --- Required: Supabase (used only as a WebSocket signalling relay, no tables needed) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Strongly recommended: a TURN server ---
# Without TURN, a peer on mobile data behind carrier NAT (CGNAT) often cannot
# connect at all. Cloudflare Realtime TURN has a generous free tier.
# Multiple URLs can be comma-separated.
NEXT_PUBLIC_TURN_URLS=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
