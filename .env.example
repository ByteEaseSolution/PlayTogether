# --- Required: Supabase (used only as a WebSocket signalling relay, no tables needed) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx

# --- Required when the two of you are on different networks: Cloudflare TURN ---
# Server-side only, NO NEXT_PUBLIC_ prefix. Cloudflare TURN keys are long-term
# secrets that cannot be used as TURN credentials directly, so /api/turn exchanges
# them for short-lived ones. Never expose these to the browser.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# --- Alternative: a provider that issues STATIC credentials (coturn, Metered) ---
# Only used when the Cloudflare variables above are unset.
NEXT_PUBLIC_TURN_URLS=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
